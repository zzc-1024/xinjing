# 服务监听端口
XINJING_SERVER_PORT=8080

# 运行环境: development / production
XINJING_APP_ENV=development

# 日志级别: debug / info / warn / error
XINJING_LOG_LEVEL=info

# 日志格式: text / json
XINJING_LOG_FORMAT=text

# 数据库驱动: sqlite(开发，零依赖) / postgres(生产，YugabyteDB 亦使用 postgres 协议)
XINJING_DB_DRIVER=sqlite

# 数据库连接串：sqlite 用文件路径；postgres 用 URL（如 postgres://user:pass@host:5432/xinjing?sslmode=disable）
XINJING_DB_DSN=xinjing.db

# 连接池：最大连接数 / 最大空闲连接数
XINJING_DB_MAX_OPEN=10
XINJING_DB_MAX_IDLE=5

# 启动时自动执行数据库迁移
XINJING_DB_AUTO_MIGRATE=true