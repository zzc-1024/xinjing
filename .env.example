# ===== 网关服务（cmd/server）=====
# 网关监听端口
XINJING_SERVER_PORT=8080

# ===== 认证服务（cmd/auth）=====
# 认证服务监听端口
XINJING_AUTH_SERVER_PORT=8081
# auth 数据库（与业务数据库分离）
XINJING_AUTH_DB_DRIVER=sqlite
XINJING_AUTH_DB_DSN=xinjing_auth.db

# 运行环境: development / production
XINJING_APP_ENV=development

# 日志级别: debug / info / warn / error
XINJING_LOG_LEVEL=info

# 日志格式: text / json
XINJING_LOG_FORMAT=text

# 数据库驱动: sqlite(开发，零依赖) / postgres(生产，YugabyteDB 亦使用 postgres 协议)
XINJING_DB_DRIVER=sqlite

# 数据库连接串：sqlite 用文件路径；postgres 用 URL（如 postgres://user:pass@host:5432/xinjing?sslmode=disable）
XINJING_DB_DSN=xinjing.db

# 连接池：最大连接数 / 最大空闲连接数
XINJING_DB_MAX_OPEN=10
XINJING_DB_MAX_IDLE=5

# 启动时自动执行数据库迁移
XINJING_DB_AUTO_MIGRATE=true

# 对象存储后端: local(开发，零依赖) / s3(生产，RustFS 等 S3 兼容服务)
XINJING_STORAGE_BACKEND=local

# local 后端的存储根目录
XINJING_STORAGE_LOCAL_DIR=./storage

# S3 配置（backend=s3 时生效；RustFS 需要 path-style 寻址）
XINJING_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
XINJING_STORAGE_S3_REGION=us-east-1
XINJING_STORAGE_S3_BUCKET=xinjing
XINJING_STORAGE_S3_ACCESS_KEY=
XINJING_STORAGE_S3_SECRET_KEY=
XINJING_STORAGE_S3_USE_PATH_STYLE=true

# 缓存后端: memory(默认，单机开发)；valkey 留待阶段 2
XINJING_CACHE_BACKEND=memory

# ===== 认证（JWT + refresh token）=====
# JWT 签名密钥对（RSA，非对称）：生成命令 go run ./cmd/keygen
# 私钥路径（签发节点需要）；公钥路径（验证节点/第三方需要）
XINJING_JWT_PRIVATE_KEY=./keys/private.pem
XINJING_JWT_PUBLIC_KEY=./keys/public.pem

# access token（JWT）有效期，默认 15 分钟
XINJING_ACCESS_TTL=15m

# refresh token 有效期，默认 720h（30 天）
XINJING_REFRESH_TTL=720h
